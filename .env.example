# Copy to .env.local (never committed) and fill in from your Supabase project:
# Supabase dashboard → Project Settings → API / Database. All of it is on the free plan.

# Public: the browser uses these to sign in with Google
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (Older projects show an "anon" key instead; NEXT_PUBLIC_SUPABASE_ANON_KEY works too.)

# Secret, server only: Connect → "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Razorpay (NETZ Pro payments). Dashboard → Account & Settings → API Keys. Use the rzp_test_ keys
# first; swap in rzp_live_ ones after KYC. The Key ID is public (Checkout needs it in the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
# Secret, server only
RAZORPAY_KEY_SECRET=...
# Secret, server only: the one you type when adding the webhook (Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=...
# Dashboard → Subscriptions → Plans: make 4 plans with these exact prices, paste their ids
RAZORPAY_PLAN_MONTHLY_INR=plan_...   # ₹199 every 1 month
RAZORPAY_PLAN_YEARLY_INR=plan_...    # ₹1,499 every 1 year
RAZORPAY_PLAN_MONTHLY_USD=plan_...   # $2.99 every 1 month (needs international payments on)
RAZORPAY_PLAN_YEARLY_USD=plan_...    # $19.99 every 1 year
NEXT_PUBLIC_USD_PAYMENTS=           # set to on once international payments and the 2 USD plans exist; until then Pricing shows rupees only

# Ads (NETZ_LAUNCH_PLAN.md section 6). All public; leave empty until made in AdSense / Ad Manager.
# AdSense display units for each ad place (empty = the landing page's unit)
NEXT_PUBLIC_ADSENSE_SLOT_ALGORITHM=
NEXT_PUBLIC_ADSENSE_SLOT_HUB=
NEXT_PUBLIC_ADSENSE_SLOT_NOTES=
NEXT_PUBLIC_ADSENSE_SLOT_PROFILE=
# Google Ad Manager unit paths: the 15-minute full-screen ad and "watch an ad, get gems"
NEXT_PUBLIC_GAM_INTERSTITIAL_UNIT=
NEXT_PUBLIC_GAM_REWARDED_UNIT=
